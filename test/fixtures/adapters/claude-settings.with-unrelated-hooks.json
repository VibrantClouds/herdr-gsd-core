{
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(npm run build)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /opt/other-plugin/hooks/session.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node /opt/other-plugin/hooks/guard.js"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "gsd-statusline"
  }
}
